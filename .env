GENERATE_SOURCEMAP=false

REACT_APP_NAME=KISS Translator M3
REACT_APP_NAME_CN=简约翻译 M3
REACT_APP_VERSION=0.0.1

REACT_APP_HOMEPAGE=https://github.com/moooyo/kiss-translator-m3
REACT_APP_RELEASES_URL=https://github.com/moooyo/kiss-translator-m3/releases
REACT_APP_REVIEW_URL=https://github.com/moooyo/kiss-translator-m3/releases
REACT_APP_SUPPORT_URL=https://github.com/moooyo/kiss-translator-m3

# 三个站点来源现在指向同一处 GitHub Pages。上游那套是 master/dev 两个自有域名 +
# 一个 Pages 镜像，我们只有 Pages，所以三者同值 —— 保留三个变量是因为
# common.js 的 options 页识别、Layout 的版本检查都按三条来源逐个比对。
SITE_ORIGIN_MASTER=https://moooyo.github.io/kiss-translator-m3
SITE_ORIGIN_GITHUB=https://moooyo.github.io/kiss-translator-m3
SITE_ORIGIN_DEV=https://moooyo.github.io/kiss-translator-m3

REACT_APP_SITEURL=$SITE_ORIGIN_MASTER
REACT_APP_SITEURL_GITHUB=$SITE_ORIGIN_GITHUB
REACT_APP_SITEURL_DEV=$SITE_ORIGIN_DEV

REACT_APP_VERSION_URL=$SITE_ORIGIN_MASTER/version.txt
REACT_APP_VERSION_URL_GITHUB=$SITE_ORIGIN_GITHUB/version.txt
REACT_APP_VERSION_URL_DEV=$SITE_ORIGIN_DEV/version.txt

# GitHub Pages 不做无扩展名重写，这里必须是 options.html
REACT_APP_OPTIONSPAGE=$SITE_ORIGIN_MASTER/options.html
REACT_APP_OPTIONSPAGE_GITHUB=$SITE_ORIGIN_GITHUB/options.html
REACT_APP_OPTIONSPAGE_DEV=$SITE_ORIGIN_DEV/options.html
REACT_APP_OPTIONSPAGE_LOCAL=http://localhost:3000/options.html

REACT_APP_LOGOURL=$SITE_ORIGIN_MASTER/images/logo192.png

# fishjar/kiss-rules 是我们继续消费的独立订阅源，不是遗留物，保持不动。
REACT_APP_RULESURL=https://fishjar.github.io/kiss-rules/kiss-rules_v2.json
REACT_APP_RULESURL_ON=https://fishjar.github.io/kiss-rules/kiss-rules-on_v2.json
REACT_APP_RULESURL_OFF=https://fishjar.github.io/kiss-rules/kiss-rules-off_v2.json

REACT_APP_USERSCRIPT_DOWNLOADURL=$SITE_ORIGIN_MASTER/kiss-translator-m3.user.js
REACT_APP_USERSCRIPT_IOS_DOWNLOADURL=$SITE_ORIGIN_MASTER/kiss-translator-m3-ios-safari.user.js
